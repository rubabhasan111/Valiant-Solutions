# Postgres connection string. Locally, `npm run dev` starts a database at this address.
# On Vercel, use Neon's pooled connection string (the host contains "-pooler").
DATABASE_URL=postgres://postgres:halfshaft-local@localhost:54320/halfshaft

# Stripe TEST secret key (sk_test_...). The app refuses to start Stripe calls with a live key.
STRIPE_SECRET_KEY=sk_test_replace_me

# Stripe publishable key (pk_test_...) for the embedded payouts and transactions panels.
# Safe to expose in the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Public base URL used for Stripe onboarding return and refresh links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signing secret for /api/webhooks/stripe (whsec_...). From `stripe listen` locally,
# or from the webhook endpoint's settings in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Bearer token the scheduler sends to /api/cron/debits. Any long random string.
CRON_SECRET=replace_with_a_long_random_string

# Email notifications to workshops and customers, sent through Resend (resend.com).
# Leave these unset in development: queued emails are recorded as skipped, not sent.
RESEND_API_KEY=
EMAIL_FROM="Halfshaft <payments@your-verified-domain.com.au>"
